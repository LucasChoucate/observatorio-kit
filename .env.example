# Modelo de variáveis de ambiente. Na etapa A este arquivo é dividido em
# web/.env.example e etl/.env.example. Os arquivos reais (.env, .env.local)
# NUNCA são commitados. As chaves ficam em Project Settings > API no Supabase.

# ---- web/.env.local (frontend: só chaves públicas) ----
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# ---- etl/.env (scripts locais: chave privilegiada, nunca no frontend) ----
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
