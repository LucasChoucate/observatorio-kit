# Copie para web/.env.local (NUNCA commitar). Chaves em Supabase > Project Settings > API.
# Somente chaves públicas: a anon key é protegida pelo RLS (só leitura).
# NUNCA coloque a service_role aqui: tudo que começa com VITE_ vai para o navegador.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon
